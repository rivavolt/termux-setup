#!/system/bin/sh
# Keep calld alive. Runs as root (calld self-drops to uid 2000 keeping audio +
# inet); started at boot by whatever boot mechanism call-nixos wires (a Magisk
# service.sh, an init script). Restarts calld on exit with capped backoff, and
# stops it with SIGTERM + a grace period so calld reverts the ADSP mixer before
# dying — a SIGKILL would latch call-audio routing for the next call.
#
# Control surface (files in DE storage so they work pre-unlock):
#   calld.enabled  present  → the loop runs calld; absent → idle (provisioned
#                            but not fighting the calld agent for the sound card)
#   calld.stop     present  → the loop exits after the current child stops
CALLD=${CALLD:-/data/local/tmp/calld}
PORT=${CALLD_PORT:-8790}
STATE=${CALLD_STATE:-/data/local/tmp}
ENABLE="$STATE/calld.enabled"
STOPFLAG="$STATE/calld.stop"
RESTART="$STATE/calld.restart"
LOCK="$STATE/calld-supervise.lock"
LOGFILE="$STATE/calld-supervise.log"
GRACE=${CALLD_GRACE:-2}
export RUST_LOG="${RUST_LOG:-info}"

# Every decision is logged three ways: stdout (discarded by service.sh), logcat for live tailing, and $LOGFILE for post-hoc inspection — logcat alone is not a record on this phone, its main buffer rotates in well under an hour under Telecom chatter, so a sparse trail vanishes exactly when someone comes looking. The file is bounded by truncation to its tail. Full path to /system/bin/log so this function doesn't recurse into itself.
log() {
  line="$(date '+%F %T') calld-supervise[$$]: $*"
  echo "$line"
  echo "$line" >> "$LOGFILE" 2>/dev/null
  if [ "$(wc -c < "$LOGFILE" 2>/dev/null || echo 0)" -gt 65536 ]; then
    tail -n 200 "$LOGFILE" > "$LOGFILE.t" 2>/dev/null && mv "$LOGFILE.t" "$LOGFILE"
  fi
  /system/bin/log -t calld-supervise "$*" 2>/dev/null || true
}

# Single supervisor. mkdir is atomic on every filesystem; flock/toybox flock is
# not guaranteed on Android, so don't depend on it. Liveness of the recorded pid
# is judged by its cmdline, not bare kill -0 — Android recycles pids fast enough
# that a stale lock can point at an unrelated live process.
if ! mkdir "$LOCK" 2>/dev/null; then
  oldpid=$(cat "$LOCK/pid" 2>/dev/null)
  if [ -n "$oldpid" ] && grep -q calld-supervise "/proc/$oldpid/cmdline" 2>/dev/null; then
    log "supervisor $oldpid already running, exiting"; exit 0
  fi
  log "clearing stale lock (pid ${oldpid:-none})"; rm -f "$LOCK/pid"
fi
echo $$ > "$LOCK/pid"
cleanup() { rm -rf "$LOCK"; }

stop_pid() {
  [ -n "$1" ] || return 0
  kill -0 "$1" 2>/dev/null || return 0
  log "SIGTERM -> calld ($1), ${GRACE}s grace"
  kill -TERM "$1" 2>/dev/null
  i=0
  while [ "$i" -lt $((GRACE * 10)) ]; do
    kill -0 "$1" 2>/dev/null || return 0
    sleep 0.1; i=$((i + 1))
  done
  log "calld ($1) did not exit in ${GRACE}s, SIGKILL"
  kill -KILL "$1" 2>/dev/null
}
child=""
stop_child() { stop_pid "$child"; }
# On our own termination, stop calld gracefully first, then release the lock.
trap 'stop_child; cleanup; exit 0' TERM INT HUP

# The tailnet address calld would bind, or empty. calld enumerates interfaces
# once at bind time and fails closed: with no 100.64/10 address it comes up
# loopback-only (never a wildcard) and STAYS that way for its whole life — and
# its tailnet listener can also die mid-life when the address flaps under it.
# tun0 specifically: a second tailscaled's interface (tailscale1) must not
# steer this gate.
tun_addr() { ip -4 addr show tun0 2>/dev/null | sed -n 's/.*inet \(100\.[0-9.]*\).*/\1/p' | head -1; }

# Whether calld actually serves $1:$PORT now. This, not an address-change edge, is the recycle criterion: comparing the current address against a start-time sample misses any flap that completes between two polls — the interface heals itself while calld's listener stays dead, which is exactly the silent loopback-only outage observed in production (three times in one day on this phone's flapping network). A level check against the listener converges from every such state.
serving() { ss -ltn 2>/dev/null | grep -qF "$1:$PORT"; }

wait_for_tailnet() {
  i=0
  while [ "$i" -lt 60 ]; do
    [ -n "$(tun_addr)" ] && return 0
    sleep 1; i=$((i + 1))
  done
  log "tailnet address not up after 60s, starting calld loopback-only (will recycle when it appears)"
}

backoff=1
while :; do
  [ -e "$STOPFLAG" ] && { log "stop flag set, exiting"; break; }
  if [ ! -e "$ENABLE" ]; then sleep 5; continue; fi
  if [ ! -x "$CALLD" ]; then log "no executable calld at $CALLD, waiting"; sleep 10; continue; fi

  # Single calld: check the abstract unix socket @calld, which calld binds
  # unconditionally (even loopback-only), rather than TCP :$PORT which is absent
  # when the tailnet was down at start. A holder that is not our child is an
  # unsupervised orphan (a supervisor died out from under it): adopt by stopping
  # it and starting our own — idling here instead would leave it unwatched, with
  # nothing to recycle it out of a loopback-only bind.
  if ss -xl 2>/dev/null | grep -q '@calld'; then
    orphans=$(pidof calld)
    log "@calld bound by unsupervised calld (pid ${orphans:-unknown}), taking over"
    # One pid at a time: pidof can return several, and stop_pid handed a multi-word arg fails its kill -0 probe and silently skips the stop, leaving the orphan holding @calld while our own start crash-loops against it.
    for orphan in $orphans; do stop_pid "$orphan"; done
    sleep 1
  fi

  wait_for_tailnet
  start_addr=$(tun_addr)
  log "starting calld (tailnet=${start_addr:-none}): $CALLD serve --port $PORT"
  "$CALLD" serve --port "$PORT" &
  child=$!

  # Supervise by polling so we can react to four things at once: calld exiting,
  # calld not serving the tailnet address that is present (needs a re-bind), and
  # the stop/restart flags. The binary deploy is a separate track (a cold
  # adb-push that never signals the process), and it can't be detected by mtime
  # — every nix-built calld carries the same epoch-0 store mtime, which adb push
  # preserves — so the deploy step touches calld.restart after pushing a new
  # build, and that is what makes an update, notably a security fix, actually
  # take effect. It doubles as a manual recycle lever.
  reason="exit"
  miss=0
  while kill -0 "$child" 2>/dev/null; do
    sleep 5
    if [ -e "$STOPFLAG" ]; then reason="stop"; break; fi
    if [ -e "$RESTART" ]; then
      log "restart flag set (new binary/config), recycling calld"; rm -f "$RESTART"
      reason="rebind"; break
    fi
    now_addr=$(tun_addr)
    # Two consecutive strikes before recycling: a single miss can be the race of polling right as a fresh calld is still binding, and one extra 5s beat is cheaper than recycling a healthy daemon. No check while the address is absent — recycling into a tailnet-less start would just produce another loopback-only calld; the strike counter arms when the address is back.
    if [ -n "$now_addr" ] && ! serving "$now_addr"; then
      miss=$((miss + 1))
      log "tailnet address $now_addr present but calld not listening on :$PORT (strike $miss)"
      if [ "$miss" -ge 2 ]; then reason="rebind"; break; fi
    else
      miss=0
    fi
  done

  case "$reason" in
    exit)
      wait "$child" 2>/dev/null; rc=$?; child=""
      log "calld exited rc=$rc"
      [ -e "$STOPFLAG" ] && { log "stop flag set after exit, done"; break; }
      if [ "$rc" -eq 0 ]; then backoff=1; else [ "$backoff" -lt 30 ] && backoff=$((backoff * 2)) || backoff=30; fi
      log "restarting in ${backoff}s"; sleep "$backoff" ;;
    rebind)
      stop_child; child=""; backoff=1 ;;   # a re-bind is not a failure
    stop)
      stop_child; child=""; log "stop flag set, exiting"; break ;;
  esac
done
cleanup
